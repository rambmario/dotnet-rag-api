<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotnetRagApi.Api</RootNamespace>
    <AssemblyName>DotnetRagApi.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetRagApi.Application\DotnetRagApi.Application.csproj" />
    <ProjectReference Include="..\DotnetRagApi.Infrastructure\DotnetRagApi.Infrastructure.csproj" />
  </ItemGroup>
</Project>
